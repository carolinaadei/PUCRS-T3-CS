# Para onde o servidor de desenvolvimento do Vite repassa as chamadas /api/*.
VITE_API_PROXY_TARGET=http://localhost:8000

# Base das chamadas feitas pelo navegador. Mantenha /api para usar o proxy.
# Se apontar direto para outra origem (ex.: https://api.exemplo.com), o backend
# precisará liberar CORS para o endereço do frontend.
VITE_API_URL=/api
